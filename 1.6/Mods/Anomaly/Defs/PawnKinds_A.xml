        <VRE_Gauranlenkin MayRequire="vanillaracesexpanded.phytokin,Ludeon.RimWorld.Ideology">0.03</VRE_Gauranlenkin>
      </xenotypeChances>
    </xenotypeSet>-->
	<modExtensions>
	  <li Class="HVPAA.AddedSpecPsycasters">
		<domesticChance>1</domesticChance>
		<pointCost>5</pointCost>
		<domesticCount>1~4</domesticCount>
		<minPsylinkLevel>1~3</minPsylinkLevel>
		<raidChance>0.3</raidChance>
		<raidCount>2~5</raidCount>
	  </li>
	</modExtensions>
  </PawnKindDef>
  
</Defs>