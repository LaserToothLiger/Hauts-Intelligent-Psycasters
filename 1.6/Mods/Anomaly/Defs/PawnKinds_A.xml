<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <!--Anomaly cultists: starting w Voidcaster, the "basic" mage type-->
  <PawnKindDef ParentName="HoraxianBase">
    <defName>HVPAA_Voidcaster</defName>
    <label>voidcaster</label>
    <combatPower>150</combatPower>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <studiableAsPrisoner>true</studiableAsPrisoner>
    <isGoodPsychicRitualInvoker>true</isGoodPsychicRitualInvoker>
    <disallowedTraitsWithDegree>
      <PsychicSensitivity>-2</PsychicSensitivity>
    </disallowedTraitsWithDegree>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>FullHead</bodyPartGroup>
        <requiredTag>HoraxianCeremonial</requiredTag>
        <useRandomStyleDef>true</useRandomStyleDef>
      </li>
      <li>
        <color>(215, 85, 85)</color>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
      </li>
      <li>
        <bodyPartGroup>Legs</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
      </li>
    </specificApparelRequirements>
    <apparelRequired>
	  <li>Apparel_PsyfocusRobe</li>
    </apparelRequired>
    <weaponTags>
      <li>NerveSpiker</li>
    </weaponTags>
    <weaponMoney>300~500</weaponMoney>
    <startingHediffs>
      <li>
        <def>Tentacle</def>
        <chance>0.2</chance>
      </li>
      <li>
        <def>FleshWhip</def>
        <chance>0.15</chance>
      </li>
      <li>
        <def>FleshmassStomach</def>
        <chance>0.15</chance>
      </li>
      <li>
        <def>FleshmassLung</def>
        <chance>0.15</chance>
      </li>
      <li>
        <def>Voidsight</def>
        <durationTicksRange>60000~300000</durationTicksRange> <!-- 1~5 days -->
      </li>
      <li>
        <def>DeathRefusal</def>
      </li>
    </startingHediffs>
	<missingParts>
      <li>
        <bodyPart>Eye</bodyPart>
      </li>
      <li>
        <bodyPart>Eye</bodyPart>
		<chance>0.65</chance>
      </li>
	</missingParts>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.025</Genie>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.025</Neanderthal>
        <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.025</Pigskin>
        <OldOne MayRequire="ellit.IlkoftheOldOnes">0.025</OldOne>
      </xenotypeChances>
    </xenotypeSet>
	<modExtensions>
	  <li Class="HVPAA.AddedSpecPsycasters">
		<domesticChance>1</domesticChance>
		<pointCost>10</pointCost>
		<domesticCount>1~4</domesticCount>
		<minPsylinkLevel>1~3</minPsylinkLevel>
		<raidChance>0.25</raidChance>
		<raidCount>1~2</raidCount>
	  </li>
	</modExtensions>
  </PawnKindDef>
  
  <!--Advanced mage type: Transgressors-->
  <PawnKindDef ParentName="HoraxianBase" Name="HVPAA_TransgressorBase" Abstract="True">
    <combatPower>400</combatPower>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <studiableAsPrisoner>true</studiableAsPrisoner>
    <isGoodPsychicRitualInvoker>true</isGoodPsychicRitualInvoker>
    <disallowedTraitsWithDegree>
      <PsychicSensitivity>-2</PsychicSensitivity>
    </disallowedTraitsWithDegree>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>FullHead</bodyPartGroup>
        <requiredTag>HoraxianCeremonial</requiredTag>
        <useRandomStyleDef>true</useRandomStyleDef>
      </li>
      <li>
        <color>(50, 0, 30)</color>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
      </li>
      <li>
        <bodyPartGroup>Legs</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
      </li>
    </specificApparelRequirements>
    <apparelRequired>
	  <li>Apparel_PsyfocusRobe</li>
    </apparelRequired>
    <weaponMoney>99999</weaponMoney>
    <weaponTags Inherit="False">
      <li>EltexStaff</li>
    </weaponTags>
    <startingHediffs>
      <li>
        <def>Voidsight</def>
        <durationTicksRange>60000~300000</durationTicksRange>
      </li>
	  <li>
        <def>HVPAA_VoidShield</def>
        <durationTicksRange>60000~300000</durationTicksRange>
	  </li>
      <li>
        <def>DeathRefusal</def>
      </li>
    </startingHediffs>
	<missingParts>
      <li>
        <bodyPart>Eye</bodyPart>
      </li>
      <li>
        <bodyPart>Eye</bodyPart>
		<chance>0.65</chance>
      </li>
	</missingParts>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.025</Genie>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.025</Neanderthal>
        <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.025</Pigskin>
        <OldOne MayRequire="ellit.IlkoftheOldOnes">0.025</OldOne>
        <AV_Kosmian MayRequire="Veltaris.Kosmian">0.02</AV_Kosmian>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>
  <PawnKindDef ParentName="HVPAA_TransgressorBase">
    <defName>HVPAA_Transgressor</defName>
    <label>transgressor</label>
	<modExtensions>
	  <li Class="HVPAA.AddedSpecPsycasters">
		<domesticChance>1</domesticChance>
		<pointCost>30</pointCost>
		<domesticCount>1</domesticCount>
		<minPsylinkLevel>3~5</minPsylinkLevel>
		<bonusPsycasts>2</bonusPsycasts>
		<raidChance>0.1</raidChance>
		<raidCount>1</raidCount>
		<combatCastIntervalOverride>90</combatCastIntervalOverride>
	  </li>
	</modExtensions>
  </PawnKindDef>
  <PawnKindDef ParentName="HVPAA_TransgressorBase"><!--sir not-appearing-in-this-mod, used in other mods-->
    <defName>HVPAA_ArchHeretic</defName>
    <label>arch-heretic</label>
    <startingHediffs>
      <li>
        <def>Regeneration</def>
        <severity>0.1</severity>
      </li>
      <li>
        <def>HVPAA_CultLeader</def>
      </li>
    </startingHediffs>
	<modExtensions>
	  <li Class="HVPAA.AddedSpecPsycasters">
		<domesticChance>0</domesticChance>
		<pointCost>99999</pointCost>
		<domesticCount>0</domesticCount>
		<minPsylinkLevel>3~5</minPsylinkLevel>
		<bonusPsycasts>2</bonusPsycasts>
		<raidChance>0</raidChance>
		<raidCount>0</raidCount>
		<combatCastIntervalOverride>90</combatCastIntervalOverride>
	  </li>
	</modExtensions>
  </PawnKindDef>
	  <HediffDef ParentName="HVT_TraitHediffBase">
		<defName>HVPAA_CultLeader</defName>
		<label>master of death</label>
		<description>Nearby corpses will periodically be animated as shamblers.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<comps>
		  <li Class="HVPAA.HediffCompProperties_Heresiarch">
			<reinforcementCount>4~7</reinforcementCount>
			<reinforcingFaction>HoraxCult</reinforcingFaction>
			<deadlifePeriodicity>500</deadlifePeriodicity>
			<deadlifeRadius>5.9</deadlifeRadius>
			<fleck>ShamblerRaiseSplatter</fleck>
			<fleckScale>3</fleckScale>
		  </li>
		  <li Class="HediffCompProperties_DisappearsOnDeath"/>
		</comps>
	  </HediffDef>
  
  <!--'unholy knight' melee-mage hybrid type: Virionclad (requires The Secret of Anima - Arsenal)-->
  <PawnKindDef ParentName="UnderthrallBase" MayRequire="tsoa.arsenal">
    <defName>HVPAA_Virionclad</defName>
    <label>virionclad</label>
    <combatPower>100</combatPower>
    <itemQuality>Good</itemQuality>
    <factionLeader>false</factionLeader>
    <canBeSapper>false</canBeSapper>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <nakedChance>0</nakedChance>
    <apparelColor>(100,80,80)</apparelColor>
    <apparelMoney>450~1100</apparelMoney>
    <apparelRequired Inherit="False">
      <li MayRequire="tsoa.arsenal">TSOA_BioferriteVirionHelm</li>
      <li MayRequire="tsoa.arsenal">TSOA_BioferriteVirionArmor</li>
    </apparelRequired>
    <techHediffsMoney>2000~6500</techHediffsMoney>
    <techHediffsMaxAmount>6</techHediffsMaxAmount>
    <techHediffsTags>
      <li>HVPAA_VoidBionics</li>
    </techHediffsTags>
	<techHediffsChance>1</techHediffsChance>
    <skills>
      <li>
        <skill>Melee</skill>
        <range>8~14</range>
      </li>
    </skills>
    <disallowedTraits>
      <li>Wimp</li>
	  <li MayRequire="Ludeon.RimWorld.Biotech">Delicate</li>
	  <li MayRequire="Hautarche.HautsTraits">HVT_Sniper</li>
    </disallowedTraits>
    <weaponMoney>99999</weaponMoney>
    <weaponTags Inherit="False">
      <li>TSOA_VoidWeaponsBasic</li>
      <li>TSOA_VoidWeaponsElite</li>
    </weaponTags>
