<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<!--Rogue Psycasters use deserter armor, 'cause they're deserters-->
	<Operation  Class="PatchOperationReplace">
	  <xpath>/Defs/PawnKindDef[defName="HVPAA_RoguePsycaster"]/apparelRequired</xpath>
	  <value>
		  <apparelRequired Inherit="False">
			<li>Apparel_EltexSkullcap</li>
			<li>VFEE_Apparel_ArmorDeserter</li>
		  </apparelRequired>
	  </value>
	</Operation>
	<!--Deserter faction-->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/FactionDef[defName="VFEE_Deserters"]</xpath>
		<value>
			<li Class="HVPAA.SpecificPsycasterRules">
				<fprd>HVPAA_Deserter</fprd>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Combat Extended</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!--again, not patching the Janissary base means Heterodoxes need the EXACT SAME PATCHES replicated for them-->
				<li Class="PatchOperationAdd">
					<xpath>Defs/PawnKindDef[defName="HVPAA_Heterodox"]</xpath>
					<value>
						<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
					</value>
				</li>
				<li Class="PatchOperationConditional">
					<xpath>Defs/PawnKindDef[defName="HVPAA_Heterodox"]/specificApparelRequirements/li[bodyPartGroup="UpperHead"]/alternateTagChoices/li[tag="Gunlink"]</xpath>
					<match Class="PatchOperationRemove">
						<xpath>Defs/PawnKindDef[defName="HVPAA_Heterodox"]/specificApparelRequirements/li[bodyPartGroup="UpperHead"]/alternateTagChoices/li[tag="Gunlink"]</xpath>
					</match>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/PawnKindDef[defName="HVPAA_Heterodox"]</xpath>
					<value>
						<li Class="CombatExtended.LoadoutPropertiesExtension">
							<primaryMagazineCount>
								<min>4</min>
								<max>6</max>
							</primaryMagazineCount>
							<sidearms>
								<li>
									<generateChance>0.5</generateChance>
									<sidearmMoney>
										<min>200</min>
										<max>400</max>
									</sidearmMoney>
									<weaponTags>
										<li>CE_Sidearm_Melee</li>
									</weaponTags>
								</li>
								<li>
									<generateChance>0.25</generateChance>
									<sidearmMoney>
										<min>10</min>
										<max>100</max>
									</sidearmMoney>
									<weaponTags>
										<li>GrenadeSmoke</li>
									</weaponTags>
									<magazineCount>
										<min>0</min>
										<max>1</max>
									</magazineCount>
								</li>
								<li>
									<generateChance>0.25</generateChance>
									<sidearmMoney>
										<min>10</min>
										<max>100</max>
									</sidearmMoney>
									<weaponTags>
										<li>GrenadeDestructive</li>
									</weaponTags>
									<magazineCount>
										<min>0</min>
										<max>0</max>
									</magazineCount>
								</li>
								<li>
									<generateChance>0.125</generateChance>
									<sidearmMoney>
										<min>80</min>
										<max>160</max>
									</sidearmMoney>
									<weaponTags>
										<li>CE_FlareLauncher</li>
									</weaponTags>
									<magazineCount>
										<min>2</min>
										<max>5</max>
									</magazineCount>
								</li>
							</sidearms>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>