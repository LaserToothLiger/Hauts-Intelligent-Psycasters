<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--let these things be used by Anima Speakers-->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>The Secret of Anima - Arsenal</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationConditional">
					<xpath>/Defs/ThingDef[@Name="TSOA_AnimaBodyPartBase"]/techHediffsTags</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[@Name="TSOA_AnimaBodyPartBase"]</xpath>
						<value>
							<techHediffsTags>
								<li>AnimaBionics</li>
							</techHediffsTags>
						</value>
					</nomatch>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[@Name="TSOA_AnimaBodyPartBase"]/techHediffsTags</xpath>
						<value>
							<li>AnimaBionics</li>
						</value>
					</match>
				</li>
				<li Class="PatchOperationAdd">
				  <xpath>/Defs/ThingDef[defName="TSOA_AnimaShamanHeaddress" or defName="TSOA_AnimaAcolyteHelmet"]/apparel/tags</xpath>
				  <value>
					  <li>HVPAA_TSOA_Headgear</li>
				  </value>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Anomaly</li>
					</mods>
					<match Class="PatchOperationConditional">
						<xpath>/Defs/ThingDef[@Name="TSOA_BioferriteBodyPartBase"]/techHediffsTags</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>/Defs/ThingDef[@Name="TSOA_BioferriteBodyPartBase"]</xpath>
							<value>
								<techHediffsTags>
									<li>HVPAA_VoidBionics</li>
								</techHediffsTags>
							</value>
						</nomatch>
						<match Class="PatchOperationAdd">
							<xpath>/Defs/ThingDef[@Name="TSOA_BioferriteBodyPartBase"]/techHediffsTags</xpath>
							<value>
								<li>HVPAA_VoidBionics</li>
							</value>
						</match>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>